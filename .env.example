# =============================================================
# Lindóya Mineral — variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha os valores.
# Variáveis com prefixo NEXT_PUBLIC_ ficam acessíveis no navegador.
# =============================================================

# URL pública do site (usada em SEO, sitemap e schema.org)
NEXT_PUBLIC_SITE_URL=https://www.lindoyamineral.com.br

# ---- Modo "Em breve" (capa até a inauguração) ----
# COMING_SOON=true faz TODA visita cair na capa /em-breve.
# No dia do lançamento, mude para false (ou remova) e o site inteiro aparece.
COMING_SOON=false
# Token do acesso interno: abra "?preview=SEU_TOKEN" p/ ver o site completo
# mesmo com a capa ligada (grava cookie). Para sair: "?preview=off".
PREVIEW_TOKEN=lindoya

# WhatsApp comercial no formato internacional, apenas dígitos.
# Ex.: 55 (Brasil) + 19 (DDD) + número -> 5519999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail de contato exibido no site
NEXT_PUBLIC_CONTACT_EMAIL=

# Senha simples da Área Comercial (opcional).
# Se vazio, a área opera em modo demonstração (materiais restritos bloqueados).
# ATENÇÃO: por ser NEXT_PUBLIC, não use como segurança real — substitua por
# autenticação (Auth.js, Supabase, Clerk) em produção.
NEXT_PUBLIC_COMMERCIAL_PASSWORD=

# Google Tag Manager / Analytics (opcional)
NEXT_PUBLIC_GTM_ID=

# Mapa (opcional, integração futura — Google Maps ou Mapbox)
NEXT_PUBLIC_MAPS_API_KEY=

# ---- Integrações de formulário (server-side, opcional) ----
# Preencha conforme a ferramenta escolhida (CRM, e-mail, webhook).
# CONTACT_WEBHOOK_URL=
# DISTRIBUTOR_WEBHOOK_URL=
# RESEND_API_KEY=
# HUBSPOT_TOKEN=
# RD_STATION_TOKEN=
